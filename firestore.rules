rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Malek's account (malekbaghdadi07@gmail.com); same uid as ADMIN_UID in src/lib/admin.ts.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'mRRUx09pGmNZcOlLoBH5KWF9lxh1';
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Each user's own data. The admin can read it, never write it.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // One small doc per account, written by that account, so the admin can list users.
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'joinedAt', 'lastSeenAt'])
        && request.resource.data.uid == userId;
    }

    // ── Compete (src/lib/compete.ts) ──────────────────────────────────────
    // Two accounts pair with an invite code. Neither can read the other's
    // users/{uid}; each publishes a summary of its linked metrics to the pair.
    function signedIn() {
      return request.auth != null;
    }
    function pairData(pairId) {
      return get(/databases/$(database)/documents/pairs/$(pairId)).data;
    }
    function isMember(pairId) {
      return signedIn() && request.auth.uid in pairData(pairId).members;
    }
    function isActiveMember(pairId) {
      return isMember(pairId) && pairData(pairId).endedAt == null;
    }

    match /invites/{code} {
      // Anyone signed in can look up one code (that's how joining works), never list them.
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code', 'fromUid', 'fromName', 'weekStartsOn', 'createdAt', 'expiresAt'])
        && !exists(/databases/$(database)/documents/pairs/$(code));
      // The inviter cancels it; the joiner removes it in the batch that creates the pair.
      allow delete: if signedIn() && (
        resource.data.fromUid == request.auth.uid
        || (existsAfter(/databases/$(database)/documents/pairs/$(code))
            && request.auth.uid in getAfter(/databases/$(database)/documents/pairs/$(code)).data.members));
    }

    match /pairs/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Created by the joiner, from a live invite whose author is the other member.
      allow create: if signedIn()
        && request.resource.data.id == pairId
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && exists(/databases/$(database)/documents/invites/$(pairId))
        && get(/databases/$(database)/documents/invites/$(pairId)).data.fromUid in request.resource.data.members
        && get(/databases/$(database)/documents/invites/$(pairId)).data.fromUid != request.auth.uid
        && request.resource.data.endedAt == null;
      // Either member can unlink, or change the name the other sees (their own only).
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt', 'names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.names[request.auth.uid] is string)
        && request.resource.data.names[request.auth.uid].size() > 0
        && request.resource.data.names[request.auth.uid].size() <= 30;

      match /links/{linkId} {
        allow read: if isMember(pairId);
        allow create: if isActiveMember(pairId) && request.resource.data.proposedBy == request.auth.uid;
        allow update: if isActiveMember(pairId);
      }
      match /challenges/{challengeId} {
        allow read: if isMember(pairId);
        allow create: if isActiveMember(pairId) && request.resource.data.createdBy == request.auth.uid;
        allow update: if isActiveMember(pairId);
      }
      // Each member writes only their own summary.
      match /scores/{uid} {
        allow read: if isMember(pairId);
        allow write: if isActiveMember(pairId) && uid == request.auth.uid;
      }
    }
  }
}
